{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-rust-starter",
  "version": "0.1.0",
  "identifier": "com.ai-rust-starter",
  "build": {
    "frontendDist": "frontend",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ai-rust-starter · KWS 控制面板",
        "width": 760,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
